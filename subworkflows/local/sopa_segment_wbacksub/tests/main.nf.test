nextflow_workflow {

    name "Test Subworkflow SOPA_SEGMENT_WBACKSUB"
    script "../main.nf"
    workflow "SOPA_SEGMENT_WBACKSUB"

    tag "subworkflows"
    tag "subworkflows_"
    tag "subworkflows/backgroundsubtract"
    tag "subworkflows/sopa_segment"
    tag "subworkflows/sopa_cellpose"
    tag "backsub"
    tag "extractmarkers"
    tag "sopa_convert"
    tag "sopa_patchifyimage"
    tag "sopa_cellpose"
    tag "sopa_resolvecellpose"
    tag "cellmeasurement"

    test("sopa_segment_wbacksub - tiff") {

        when {
            params {
                remove_markers = 'TRITC'
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'test' ],
                    file('${projectDir}/tests/data/comet/synthetic_multichannel.tif'), // tiff
                    "DAPI", // nuclear channel
                    "CD45"  // membrane channels
                ])

                // An empty directory is a valid input: the module links its
                // contents into a task-local cache, so tasks fall back to
                // downloading the weights themselves. Set --cellpose_models_dir
                // to a pre-staged copy to make this test much faster.
                modelsDir = params.cellpose_models_dir
                    ? file(params.cellpose_models_dir, checkIfExists: true)
                    : file("cellpose_models", type: 'dir')
                modelsDir.mkdirs()
                input[1] = modelsDir
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                // Snapshot the NAMED emits only, minus kronos_input.
                //
                // workflow.out carries every channel twice -- once positionally ("0",
                // "1", ...) and once by name -- so filtering by name alone still leaves
                // the positional copy. kronos_input re-exports the input image, which on
                // the backsub paths is a generated OME-TIFF stamped with a fresh UUID per
                // run (Creator="backsub"), making its md5 unreproducible. It is plumbing
                // for the top-level KRONOS2 call and is covered there.
                { assert snapshot(workflow.out.findAll { entry ->
                    !entry.key.toString().isNumber() && entry.key != 'kronos_input'
                }).match()}
            )
        }
    }
}
