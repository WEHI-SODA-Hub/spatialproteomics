nextflow_workflow {

    name "Test Subworkflow SOPA_SEGMENT_COMPARTMENT"
    script "../main.nf"
    workflow "SOPA_SEGMENT_COMPARTMENT"

    tag "subworkflows"
    tag "subworkflows_"
    tag "subworkflows/sopa_segment_compartment"
    tag "subworkflows/sopa_cellpose"
    tag "sopa_convert"
    tag "sopa_patchifyimage"
    tag "sopa_cellpose"
    tag "sopa_resolvecellpose"

    test("sopa_segment_compartment - tiff - whole-cell") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'test' ],
                    file('${projectDir}/tests/data/comet/synthetic_bgsub.ome.tif'), // tiff
                    "DAPI", // nuclear channel
                    "CD45"  // membrane channels
                ])
                input[1] = 'whole-cell'

                // An empty directory is a valid input: the module links its
                // contents into a task-local cache, so tasks fall back to
                // downloading the weights themselves. Set --cellpose_models_dir
                // to a pre-staged copy to make this test much faster.
                modelsDir = params.cellpose_models_dir
                    ? file(params.cellpose_models_dir, checkIfExists: true)
                    : file("cellpose_models", type: 'dir')
                modelsDir.mkdirs()
                input[2] = modelsDir
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(workflow.out).match()}
            )
        }
    }

    test("sopa_segment_compartment - tiff - nuclear") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'test' ],
                    file('${projectDir}/tests/data/comet/synthetic_bgsub.ome.tif'), // tiff
                    "DAPI", // nuclear channel
                    ""      // membrane channels
                ])
                input[1] = 'nuclear'

                // An empty directory is a valid input: the module links its
                // contents into a task-local cache, so tasks fall back to
                // downloading the weights themselves. Set --cellpose_models_dir
                // to a pre-staged copy to make this test much faster.
                modelsDir = params.cellpose_models_dir
                    ? file(params.cellpose_models_dir, checkIfExists: true)
                    : file("cellpose_models", type: 'dir')
                modelsDir.mkdirs()
                input[2] = modelsDir
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(workflow.out).match()}
            )
        }
    }
}
