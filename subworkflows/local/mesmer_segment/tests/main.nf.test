nextflow_workflow {

    name "Test Subworkflow MESMER_SEGMENT"
    script "../main.nf"
    workflow "MESMER_SEGMENT"

    tag "subworkflows"
    tag "subworkflows_"
    tag "subworkflows/mesmer_segment"
    tag "mesmersegment"
    tag "cellmeasurement"


    test("mesmer_segment - tiff") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'test' ],
                    false,  // run_backsub
                    true,   // run_mesmer
                    false,  // run_cellpose
                    false,  // run_cellsam
                    file("${projectDir}/tests/data/mesmer/test_data.tiff", checkIfExists: true), // tiff
                    "nuclear",     // nuclear_channel
                    "membrane" // membrane_channels
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                // kronos_input is excluded: it re-exports the input image, which on the
                // backsub paths is a generated OME-TIFF carrying a fresh UUID per run
                // (Creator="backsub"), so its md5 is not reproducible. The channel is
                // plumbing for the top-level KRONOS2 call and is covered there.
                { assert snapshot(workflow.out.findAll { entry -> entry.key != 'kronos_input' }).match()}
            )
        }
    }
}
