/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/data/spatial_omics'

    // Reuse a pre-staged Cellpose model cache when one is available, rather
    // than downloading ~1.2 GB per test run. CI restores it from actions/cache;
    // locally, export CELLPOSE_MODELS_DIR=/path/to/cellpose_models.
    cellpose_models_dir = System.getenv('CELLPOSE_MODELS_DIR') ?: null
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners
