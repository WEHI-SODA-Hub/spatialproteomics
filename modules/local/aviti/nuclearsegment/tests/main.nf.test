nextflow_process {

    name "Test Process AVITINUCLEARSEGMENT"
    script "../main.nf"
    process "AVITINUCLEARSEGMENT"

    tag "modules"
    tag "modules_local"
    tag "aviti"
    tag "aviti_nuclearsegment"

    // Real (non-stub) execution requires a GPU + the pinned Cellpose 3.0.7
    // custom nuclear model, neither of which is available in this test
    // environment, so only the stub path is exercised here. The underlying
    // Python logic is covered independently by
    // tests/python/test_aviti_nuclear_segment.py.
    test("aviti_nuclearsegment - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test__WellA1__L1R01C01S1', tile:'L1R01C01S1' ], // meta map
                    file('${projectDir}/tests/data/aviti/Projection/WellA1/CP01_L1R01C01S1_Nucleus.tif', checkIfExists: true)
                ]
                input[1] = file('${projectDir}/tests/data/aviti/Projection/WellA1/CP01_L1R01C02S1_Nucleus.tif', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
