nextflow_process {

    name "Test Process AVITIDISCOVERTILES"
    script "../main.nf"
    process "AVITIDISCOVERTILES"

    tag "modules"
    tag "modules_local"
    tag "aviti"
    tag "aviti_discovertiles"

    test("aviti_discovertiles - real run directory") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test_run', wells:'' ], // meta map
                    file('${projectDir}/tests/data/aviti', checkIfExists: true) // run_dir
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.manifest[0][1]).readLines().size() == 3 }, // header + 2 tiles
                { assert snapshot(process.out.versions).match() }
            )
        }

    }

    test("aviti_discovertiles - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test_stub', wells:'' ], // meta map
                    file('${projectDir}/tests/data/aviti', checkIfExists: true) // run_dir
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
