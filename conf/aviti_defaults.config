// AVITI-specific defaults. Pass this file with `-c conf/aviti_defaults.config`
// to override the pipeline's global defaults with AVITI-friendly values
// without editing nextflow.config. This file intentionally reuses the existing
// global parameter names (pixel_size_microns, cellpose_*) so the AVITI path
// can share the same settings surface as the rest of the pipeline.

params {
    pixel_size_microns            = 0.25
    cellpose_pretrained_model     = 'cpsam_v2'
    cellpose_diameter             = 30
    cellpose_flow_threshold       = 0.4
    cellpose_cellprob_threshold   = 0.0
    cellpose_min_area             = 0

    aviti_channel_mode            = 'auto'
    aviti_cellpaint_batch         = 'CP01'
}
