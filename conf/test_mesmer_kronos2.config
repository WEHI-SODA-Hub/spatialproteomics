/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests with Mesmer and KRONOS2
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    KRONOS2 weights are gated on Hugging Face, so they cannot be fetched in CI.
    Download the FULL snapshot once and point this profile at it:

        hf download MahmoodLab/KRONOS2 --local-dir /path/to/KRONOS2 \
            --exclude "demo_image/*"
        export KRONOS2_MODEL_DIR=/path/to/KRONOS2

    The whole snapshot is required (not a file subset): the model's loader adds
    the directory to sys.path and imports the bundled `dinov2` package.

    Use as follows:
        nextflow run WEHI-SODA-Hub/sp_segment -profile test_mesmer_kronos2,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test Mesmer with KRONOS2 profile'
    config_profile_description = 'Minimal test dataset to check Mesmer and KRONOS2 pipeline function'

    input                      = 'tests/mesmer_samplesheet.csv'
    remove_markers             = 'TRITC'

    enable_kronos              = true

    // Gated weights: the user supplies the snapshot path via an env var.
    kronos_model_path          = System.getenv("KRONOS2_MODEL_DIR")

    // The synthetic test panel is DAPI + CD45, both of which are in KRONOS2's
    // 288-marker vocabulary, so no marker mapping is needed and the run must
    // not need --allow-novel-defaults. If that gate ever trips here, the panel
    // or the vocabulary has changed and the failure is informative.
    kronos_patch_size          = 64
    kronos_batch_size          = 16
}
